
{
  "version": 2,
  "functions": {
    "api/index.js": {
      "supportsResponseStreaming": true
    }
  },
  "rewrites": [
    {
      "source": "/socket.io",
      "destination": "/api/index"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
